---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Gift Ideas" description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Gift Ideas</h1>
			<section>
				<h2>Donate to Organizations</h2>
				<p>In recognition of the many supports we feel privileged to have received, and in an effort to redistribute resources, we would be honored if you’d like to donate to organizations doing meaningful work in our community:</p>
				<ul style="line-height: 2;">
					<li>
						<strong><a href="https://maternitycarecoalition.org/who-we-are" target="_blank" rel="noopener noreferrer">Maternity Care Coalition</a></strong> - <a href="https://maternitycarecoalition.org/get-involved/donate" target="_blank" rel="noopener noreferrer">Donate</a>
					</li>
					<li>
						<strong><a href="https://abortionfundpa.org/" target="_blank" rel="noopener noreferrer">Abortion Liberation Fund of PA</a></strong> - <a href="https://secure.qgiv.com/for/abortionliberationfundofpa/" target="_blank" rel="noopener noreferrer">Donate</a>
					</li>
					<li>
						<strong><a href="https://www.vamosjuntos.org/" target="_blank" rel="noopener noreferrer">Juntos</a></strong> - <a href="https://secure.qgiv.com/for/mandres/" target="_blank" rel="noopener noreferrer">Donate</a>
					</li>
				</ul>
			</section>
			<section>
				<h2>Registry</h2>
				<p>We are grateful to have lots of hand-me-downs and second-hand items. If you feel it’s important to give us a new gift, here is a <a href="https://my.babylist.com/kyxhmuwta" target="_blank" rel="noopener noreferrer">Babylist gift registry for the new baby</a> and an <a href="https://www.amazon.com/registries/gl/guest-view/2G3R6SMC72SV?ref_=cm_sw_r_cp_ud_ggr-subnav-share_5NZCB3PDDG5N9E2K48HP" target="_blank" rel="noopener noreferrer">Amazon gift registry for Yona</a>.</p>
			</section>
			<section>
				<h2>Donate to Yona's College Fund</h2>
				<p>If you would like to make a contribution to Yona's PA 529 College Guaranteed Savings Plan, please use the following information:</p>
				<ol style="line-height: 2;">
					<li>
						Go to <a href="https://Ugift529.com" target="_blank" rel="noopener noreferrer">Ugift529.com</a>
					</li>
					<li>
						Enter the Ugift code: <strong>U2K-H63</strong>
					</li>
					<li>
						Enter your name and the amount of your gift.
					</li>
					<li>
						Make your gift via electronic funds transfer or check.
					</li>
				</ol>
			</section>
		</main>
	</body>
</html>

<style>
	.registry-link {
		display: inline-block;
		padding: 0.75em 1.5em;
		background-color: var(--accent);
		color: white;
		text-decoration: none;
		border-radius: 8px;
		font-weight: 600;
		transition: background-color 0.2s ease, transform 0.1s ease;
		box-shadow: 0 2px 4px rgba(var(--black), 0.1);
	}
	
	.registry-link:hover {
		background-color: var(--accent-dark);
		transform: translateY(-1px);
		box-shadow: 0 4px 8px rgba(var(--black), 0.15);
	}
	
	.registry-link:active {
		transform: translateY(0);
	}
	
	section {
		margin-bottom: 2em;
	}
</style>

