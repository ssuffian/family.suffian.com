---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

// Calculate on each request, rounded to the nearest quarter-year.
const birthDate = Date.UTC(2024, 2, 1);
const quarters = Math.max(0, Math.round((Date.now() - birthDate) / (365.25 * 24 * 60 * 60 * 1000) * 4));
const years = Math.floor(quarters / 4);
const fraction = ['', '1/4', '1/2', '3/4'][quarters % 4];
const age = fraction ? (years ? `${years} ${fraction}` : fraction) : String(years);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<p>
				Hello, you've reached Steve and Becky's website.
			</p>
			<p>Use this website to see <a href="/new-baby-faq">FAQ</a> about the new baby, what books we already have in our <a href="/library">children’s book library</a>, or some <a href="/gift-ideas">gift ideas</a>.</p>
			<p>Yona is {age} years old.</p>
			<p>E-mail <a href="mailto:celebratebeckysteve@gmail.com">celebratebeckysteve@gmail.com</a> to get access to our Google Photos album.</p>
			<p>
				Our address for visits, deliveries, packages, everything is:<br />
				Becky Mer and Steve Suffian<br />
				1643 Kater Street<br />
				Philadelphia, PA 19146
			</p>
		</main>
	</body>
</html>
